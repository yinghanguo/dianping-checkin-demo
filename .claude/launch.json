{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Report Static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "8899", "public"],
      "port": 8899
    },
    {
      "name": "Vite Dev HTTP",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:http"],
      "port": 5174
    },
    {
      "name": "Vite Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "Vite Preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 4173
    }
  ]
}
